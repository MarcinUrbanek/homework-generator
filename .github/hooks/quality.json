{
  "hooks": {
    "PostToolUse": [
      {
        "type": "command",
        "command": "node .github/hooks/quality.mjs",
        "cwd": ".",
        "timeout": 90
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node .github/hooks/quality.mjs",
        "cwd": ".",
        "timeout": 240
      }
    ]
  }
}
