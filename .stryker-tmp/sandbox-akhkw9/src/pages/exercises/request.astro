---
import RequestExercisesForm from "@/components/exercises/RequestExercisesForm";
import Layout from "@/layouts/Layout.astro";
import { authorizeTeacher } from "@/lib/services/teacher-authorization";
import { createClient } from "@/lib/supabase";

const supabase = createClient(Astro.request.headers, Astro.cookies);
const authorization = await authorizeTeacher(Astro.locals, supabase);
const isAuthorized = authorization.status === "authorized-teacher";

if (!isAuthorized) {
  Astro.response.status = 403;
}
---

<Layout title={isAuthorized ? "Generowanie zadań" : "Brak dostępu"}>
  <main data-role="teacher" class="min-h-screen bg-background px-4 py-8 text-foreground sm:py-12">
    <div class="mx-auto w-full max-w-3xl">
      <a href="/dashboard" class="text-sm font-semibold text-primary underline-offset-4 hover:underline">
        Powrót do panelu
      </a>

      {isAuthorized ? (
        <section class="mt-6 rounded-lg border bg-card p-5 text-card-foreground shadow-sm sm:p-8">
          <p class="text-sm font-semibold text-primary">Matematyka · klasa 4</p>
          <h1 class="mt-2 text-3xl font-bold sm:text-4xl">Wygeneruj propozycje zadań</h1>
          <p class="mt-3 max-w-2xl text-sm leading-6 text-muted-foreground sm:text-base">
            Wybierz temat i poziom trudności. Otrzymane zadania oraz odpowiedzi są propozycjami i wymagają weryfikacji
            przed użyciem.
          </p>
          <RequestExercisesForm client:load />
        </section>
      ) : (
        <section class="mt-6 rounded-lg border border-destructive/30 bg-card p-6 text-card-foreground shadow-sm sm:p-8">
          <p class="text-sm font-semibold text-destructive">Brak dostępu</p>
          <h1 class="mt-2 text-3xl font-bold">Ta strona jest dostępna tylko dla nauczycieli</h1>
          <p class="mt-3 leading-7 text-muted-foreground">
            Nie udało się potwierdzić uprawnień nauczyciela dla tego konta.
          </p>
        </section>
      )}
    </div>
  </main>
</Layout>
