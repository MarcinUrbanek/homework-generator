---
import ExerciseRequestStateGallery from "@/components/exercises/ExerciseRequestStateGallery";
import Layout from "@/layouts/Layout.astro";

const isDevelopment = import.meta.env.DEV;

if (!isDevelopment) {
  Astro.response.status = 404;
}
---

{isDevelopment && (
  <Layout title="Exercise request state gallery">
    <ExerciseRequestStateGallery client:load />
  </Layout>
)}
