---
import HomeworkAssignmentForm from "@/components/homework/HomeworkAssignmentForm";
import Layout from "@/layouts/Layout.astro";
import { homeworkClassIdSchema } from "@/lib/homework/schemas";
import { authorizeTeacher } from "@/lib/services/teacher-authorization";
import { createClient } from "@/lib/supabase";

const classId = homeworkClassIdSchema.safeParse(Astro.params.classId);
const supabase = createClient(Astro.request.headers, Astro.cookies);
const authorization = await authorizeTeacher(Astro.locals, supabase);
const isAuthorized = authorization.status === "authorized-teacher";

if (!classId.success) {
  Astro.response.status = 404;
} else if (!isAuthorized) {
  Astro.response.status = 403;
}
---

<Layout title={classId.success && isAuthorized ? "Przydziel zadania" : "Brak dostępu"}>
  <main data-role="teacher" class="min-h-screen bg-background px-4 py-8 text-foreground sm:py-12">
    <div class="mx-auto w-full max-w-3xl">
      <a href="/classes" class="text-sm font-semibold text-primary underline-offset-4 hover:underline">
        Powrót do klas
      </a>

      {classId.success && isAuthorized ? (
        <section class="mt-6 rounded-lg border bg-card p-5 text-card-foreground shadow-sm sm:p-8">
          <p class="text-sm font-semibold text-primary">Przestrzeń nauczyciela · klasa 4</p>
          <h1 class="mt-2 text-3xl font-bold sm:text-4xl">Przydziel zadania</h1>
          <p class="mt-3 max-w-2xl text-sm leading-6 text-muted-foreground sm:text-base">
            Wybierz uczniów i parametry zestawu. Przydział zostanie zapisany dla aktualnych członków klasy.
          </p>
          <HomeworkAssignmentForm client:load classId={classId.data} />
        </section>
      ) : !classId.success ? (
        <section class="mt-6 rounded-lg border border-destructive/30 bg-card p-6 text-card-foreground shadow-sm sm:p-8">
          <p class="text-sm font-semibold text-destructive">Klasa niedostępna</p>
          <h1 class="mt-2 text-3xl font-bold">Nie można otworzyć tego przydzielenia</h1>
        </section>
      ) : (
        <section class="mt-6 rounded-lg border border-destructive/30 bg-card p-6 text-card-foreground shadow-sm sm:p-8">
          <p class="text-sm font-semibold text-destructive">Brak dostępu</p>
          <h1 class="mt-2 text-3xl font-bold">Ta strona jest dostępna tylko dla nauczycieli</h1>
          <p class="mt-3 leading-7 text-muted-foreground">
            Nie udało się potwierdzić uprawnień nauczyciela dla tego konta.
          </p>
        </section>
      )}
    </div>
  </main>
</Layout>
