---
import RequestExercisesForm from "@/components/exercises/RequestExercisesForm";
import Layout from "@/layouts/Layout.astro";
import { authorizeTeacher } from "@/lib/services/teacher-authorization";
import { createClient } from "@/lib/supabase";

const supabase = createClient(Astro.request.headers, Astro.cookies);
const authorization = await authorizeTeacher(Astro.locals, supabase);
const isAuthorized = authorization.status === "authorized-teacher";

if (!isAuthorized) {
  Astro.response.status = 403;
}
---

<Layout title={isAuthorized ? "Generowanie zadań" : "Brak dostępu"}>
  <main class="bg-cosmic min-h-screen px-4 py-8 text-white sm:py-12">
    <div class="mx-auto w-full max-w-3xl">
      <a href="/dashboard" class="text-sm font-semibold text-blue-200 hover:text-white hover:underline">
        Powrót do panelu
      </a>

      {isAuthorized ? (
        <section class="mt-6 rounded-lg border border-white/10 bg-white/10 p-5 backdrop-blur-xl sm:p-8">
          <p class="text-sm font-semibold text-cyan-200">Matematyka · klasa 4</p>
          <h1 class="mt-2 text-3xl font-bold text-white sm:text-4xl">Wygeneruj propozycje zadań</h1>
          <p class="mt-3 max-w-2xl text-sm leading-6 text-blue-100/75 sm:text-base">
            Wybierz temat i poziom trudności. Otrzymane zadania oraz odpowiedzi są propozycjami i wymagają weryfikacji
            przed użyciem.
          </p>
          <RequestExercisesForm client:load />
        </section>
      ) : (
        <section class="mt-6 rounded-lg border border-red-200/20 bg-white/10 p-6 backdrop-blur-xl sm:p-8">
          <p class="text-sm font-semibold text-red-200">Brak dostępu</p>
          <h1 class="mt-2 text-3xl font-bold">Ta strona jest dostępna tylko dla nauczycieli</h1>
          <p class="mt-3 leading-7 text-blue-100/75">Nie udało się potwierdzić uprawnień nauczyciela dla tego konta.</p>
        </section>
      )}
    </div>
  </main>
</Layout>
