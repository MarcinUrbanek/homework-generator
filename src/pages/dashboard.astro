---
import Layout from "@/layouts/Layout.astro";

const { user } = Astro.locals;
---

<Layout title="Panel nauczyciela">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-xl rounded-lg border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl sm:p-8">
      <h1 class="mb-3 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Panel
      </h1>
      <p class="text-blue-100/80">
        Zalogowano jako <span class="font-semibold text-white">{user?.email}</span>
      </p>

      <div class="mt-8 border-t border-white/10 pt-6">
        <h2 class="text-lg font-semibold">Klasy i zaproszenia</h2>
        <p class="mt-1 text-sm leading-6 text-blue-100/70">
          Twórz klasy, korzystaj z ich kodów i wysyłaj zaproszenia uczniom.
        </p>
        <a
          href="/classes"
          class="mt-4 inline-flex min-h-10 items-center justify-center rounded-md bg-white px-4 py-2 text-sm font-semibold text-slate-950 transition-colors hover:bg-blue-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        >
          Otwórz klasy
        </a>
      </div>

      <div class="mt-8 border-t border-white/10 pt-6">
        <h2 class="text-lg font-semibold">Twoje klasy</h2>
        <div class="mt-4 flex flex-col gap-3 sm:flex-row">
          <a
            href="/classes/joined"
            class="inline-flex min-h-10 items-center justify-center rounded-md border border-white/30 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
          >
            Zobacz dołączone klasy
          </a>
          <a
            href="/classes/join-code"
            class="inline-flex min-h-10 items-center justify-center rounded-md border border-white/30 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
          >
            Dołącz za pomocą kodu
          </a>
        </div>
      </div>

      <div class="mt-8 border-t border-white/10 pt-6">
        <h2 class="text-lg font-semibold">Zadania z matematyki</h2>
        <p class="mt-1 text-sm leading-6 text-blue-100/70">
          Wybierz temat i poziom trudności, a następnie wygeneruj propozycje zadań do sprawdzenia.
        </p>
        <a
          href="/exercises/request"
          class="mt-4 inline-flex min-h-10 items-center justify-center rounded-md bg-white px-4 py-2 text-sm font-semibold text-slate-950 transition-colors hover:bg-blue-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        >
          Wygeneruj zadania
        </a>
        <a
          href="/exercises/saved"
          class="mt-3 inline-flex min-h-10 items-center justify-center rounded-md border border-white/30 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        >
          Przeglądaj zatwierdzone zadania
        </a>
      </div>

      <form method="POST" action="/api/auth/signout" class="mt-8 border-t border-white/10 pt-6">
        <button
          type="submit"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          Wyloguj się
        </button>
      </form>
    </div>
  </div>
</Layout>
