---
import SavedExercisePoolStateGallery from "@/components/exercises/SavedExercisePoolStateGallery";
import Layout from "@/layouts/Layout.astro";

const isDevelopment = import.meta.env.DEV;

if (!isDevelopment) {
  Astro.response.status = 404;
}
---

{isDevelopment && (
  <Layout title="Saved exercise pool state gallery">
    <SavedExercisePoolStateGallery client:load />
  </Layout>
)}
